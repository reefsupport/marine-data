# Operator values for `create.sh --target pve`. Copy this file to deploy/release-vm/pve.env (git-ignored),
# replace every value with your own, then pass it with --env-file:
#
#   cp deploy/release-vm/pve.env.example deploy/release-vm/pve.env
#   deploy/release-vm/create.sh --target pve --release-id v1.1.0 --flavour open --ref <40-hex sha> \
#     --env-file deploy/release-vm/pve.env
#
# KEY=VALUE lines only: the file is read, never sourced, and only the keys below are accepted. A flag
# or an environment variable of the same name wins over the file. Names and addresses, no secrets.

# The Proxmox host: the ssh jump host in the commands create.sh prints.
PVE_HOST=pve.example.internal
# The login user cloud-init creates in the VM.
PVE_CI_USER=admin
# The existing VM whose cloud-init `sshkeys` the new VM gets (0 is a placeholder: set your own).
PVE_SSHKEYS_FROM_VMID=0
# The comments of those keys, comma and space between them. The host script prints the fingerprints
# (ssh-keygen -lf) next to this list so you can compare them before the VM is created.
PVE_KEY_COMMENTS="root@pve.example.internal, deploy-key-example"
# Address of the VM (CIDR), its gateway and the bridge it attaches to.
PVE_STATIC_IP=10.0.0.90/24
PVE_GATEWAY=10.0.0.2
PVE_BRIDGE=vmbr1
# The id of the VM to create. The host script stops if it exists.
PVE_VMID=900

# Optional, with the generic defaults shown (uncomment to change):
# PVE_NAME=marinedata-build
# PVE_NAMESERVER=1.1.1.1
# PVE_STORAGE=local-lvm
# PVE_IMAGE=local:iso/debian-12-genericcloud-amd64.qcow2
# PVE_CORES=6
# PVE_MEMORY=16384
# PVE_DATA_GB=100
# PVE_KEYS_FILE=/root/vm900-keys.pub
